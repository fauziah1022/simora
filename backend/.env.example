# ============================================
# SIMORA - Environment Configuration
# Salin file ini menjadi .env lalu sesuaikan
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- JWT ---
JWT_SECRET=simora_super_secret_key_ganti_ini
JWT_EXPIRES_IN=7d

# --- Daftar Kode Cabang Aktif (pisahkan dengan koma, tanpa spasi) ---
CABANG_LIST=bandung,tasikmalaya,garut

# ============================================
# DATABASE PUSAT (Server Admin Pusat)
# ============================================
DB_PUSAT_HOST=localhost
DB_PUSAT_PORT=5432
DB_PUSAT_NAME=simora_pusat
DB_PUSAT_USER=postgres
DB_PUSAT_PASSWORD=postgres

# ============================================
# DATABASE CABANG BANDUNG
# (Disimulasikan seolah server terpisah)
# ============================================
DB_CABANG_BANDUNG_HOST=localhost
DB_CABANG_BANDUNG_PORT=5432
DB_CABANG_BANDUNG_NAME=simora_cabang_bandung
DB_CABANG_BANDUNG_USER=postgres
DB_CABANG_BANDUNG_PASSWORD=postgres

# ============================================
# DATABASE CABANG TASIKMALAYA
# ============================================
DB_CABANG_TASIKMALAYA_HOST=localhost
DB_CABANG_TASIKMALAYA_PORT=5432
DB_CABANG_TASIKMALAYA_NAME=simora_cabang_tasikmalaya
DB_CABANG_TASIKMALAYA_USER=postgres
DB_CABANG_TASIKMALAYA_PASSWORD=postgres

# ============================================
# DATABASE CABANG GARUT
# ============================================
DB_CABANG_GARUT_HOST=localhost
DB_CABANG_GARUT_PORT=5432
DB_CABANG_GARUT_NAME=simora_cabang_garut
DB_CABANG_GARUT_USER=postgres
DB_CABANG_GARUT_PASSWORD=postgres
